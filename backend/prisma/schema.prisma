  games   Int

  @@id([season, week, team])
}

/// Pregame win probability and projected score for every game (ingest/models.py).
model game_predictions {
  game_id       String   @id
  season        Int
  week          Int
  game_type     String?
  home_team     String
  away_team     String
  home_wp       Float
  home_proj     Float
  away_proj     Float
  proj_margin   Float
  model_version String
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([season, week], map: "game_predictions_season_week_idx")
}

